# --- CMake build trees ----------------------------------------------------
/build/
/build-*/
/cmake-build-*/
compile_commands.json
CMakeUserPresets.json

# --- Local install prefix (cmake --preset local) --------------------------
/.local/

# --- Compiled objects and libraries -------------------------------------
# The legacy in-tree DJGPP build (ivandj.mak) still compiles in the source
# tree, so keep the classic object/binary patterns around.
*.o
*.a
*.lo
*.la
*.obj
*.lib
*.so
*.dll
*.dylib

# --- Built binaries ------------------------------------------------------
# ivandj.mak produces IVAN.exe in the tree
ivan
ivan.exe
*.exe

# --- Editor and OS cruft -------------------------------------------------
*~
*.swp
*.orig
*.rej
.DS_Store