# Generated by CMake from cmake/InstallPermissions.cmake.in -- do not edit.
#
# Mirrors the old autotools install-data-local rule (Makefile.am), split into
# two parts:
#
#  Always (UNIX), best-effort:
#    - create $(localstatedir)/ivan/Bones/
#    - create $(localstatedir)/ivan/ivan-highscore.scores
#    - chmod 664 on the highscore file, chmod u=rwx,g=rwx,o=r on Bones/
#  Only with IVAN_INSTALL_PERMS=ON (needs root and a "games" group):
#    - chown games:games on the highscore file and Bones/
#    - chgrp games + chmod 2111 on the binary (setgid game group)
#
# Every step is allowed to fail: a warning is printed instead of aborting the
# installation (the old Makefile rules were prefixed with "-" for the same
# reason, and a plain "make install" as a normal user is expected to work).

set(_root "$ENV{DESTDIR}")
set(_statedir "${_root}@IVAN_LOCALSTATEDIR@")
set(_score "${_statedir}/ivan-highscore.scores")
set(_bones "${_statedir}/Bones")
set(_binary "${_root}@CMAKE_INSTALL_PREFIX@/@CMAKE_INSTALL_BINDIR@/ivan")

function(_ivan_step _what)
  execute_process(COMMAND ${ARGN}
                  RESULT_VARIABLE _rc
                  ERROR_VARIABLE _err
                  OUTPUT_QUIET)
  if(NOT _rc EQUAL 0)
    message(WARNING "IVAN install: ${_what} failed: ${_err}")
  endif()
endfunction()

_ivan_step("create state directory" ${CMAKE_COMMAND} -E make_directory "${_statedir}")
_ivan_step("create Bones directory" ${CMAKE_COMMAND} -E make_directory "${_bones}")

if(NOT EXISTS "${_score}")
  _ivan_step("create highscore file" ${CMAKE_COMMAND} -E touch "${_score}")
endif()

_ivan_step("chmod highscore" chmod 664 "${_score}")
_ivan_step("chmod Bones" chmod -R u=rwx,g=rwx,o=r "${_bones}")

if("@IVAN_INSTALL_PERMS@")
  _ivan_step("chown highscore" chown games:games "${_score}")
  _ivan_step("chown Bones" chown -R games:games "${_bones}")
  _ivan_step("chgrp ivan" chgrp games "${_binary}")
  _ivan_step("chmod ivan (setgid)" chmod 2111 "${_binary}")
endif()